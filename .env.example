# Public settings (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret: Supabase Connect > Transaction pooler, port 6543.
# URL-encode the password. Never use NEXT_PUBLIC_ for this value.
SUPABASE_DB_URL=postgresql://postgres.PROJECT-REF:URL_ENCODED_PASSWORD@POOLER-HOST:6543/postgres

# Optional one-time administrator activation code; remove after activation.
ADMIN_SETUP_TOKEN=
# Google credentials belong only in Supabase's Google provider settings.
